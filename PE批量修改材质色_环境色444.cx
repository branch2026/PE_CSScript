  <UsingText>using System;
using System.Windows.Forms;
using PEPlugin;
using PEPlugin.Pmx;
using PEPlugin.SDX;</UsingText>
  <FullCodeText>public sealed class CSScriptClass : PEPluginClass
{
    private const string Title = "批量修改环境色";

    public CSScriptClass()
    {
        m_option = new PEPluginOption(false, true, Title);
    }

    public override void Run(IPERunArgs args)
    {
        try
        {
            int count = Apply(args.Host.Connector);
            MessageBox.Show("已修改 " + count + " 项材质的环境色。\nRGB (4, 4, 4)",
                Title, MessageBoxButtons.OK, MessageBoxIcon.Information);
        }
        catch (Exception ex)
        {
            MessageBox.Show(ex.Message, Title, MessageBoxButtons.OK, MessageBoxIcon.Warning);
        }
    }

    internal static int Apply(IPEConnector editor)
    {
        IPXPmx model = editor.Pmx.GetCurrentState();
        if (model == null || model.Material.Count == 0)
            throw new InvalidOperationException("请先打开含有材质的 PMX 模型。");

        foreach (IPXMaterial material in model.Material)
        {
            material.Ambient = new V3(4f, 4f, 4f);
        }

        editor.Pmx.Update(model, PmxUpdateObject.Material, -1);
        editor.Form.UpdateList(PEPlugin.Pmd.UpdateObject.Material);
        editor.View.PMDView.UpdateModel();
        editor.View.PMDView.UpdateView();
        return model.Material.Count;
    }
}

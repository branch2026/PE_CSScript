<?xml version="1.0" encoding="utf-8"?>
<CSScriptData>
  <ScriptType>CS2</ScriptType>
  <CompilerVersion>4</CompilerVersion>
  <ReferenceAssemblies>
    <string>System.dll</string>
    <string>System.Core.dll</string>
    <string>System.Data.dll</string>
    <string>System.Data.DataSetExtensions.dll</string>
    <string>System.Deployment.dll</string>
    <string>System.Drawing.dll</string>
    <string>System.Windows.Forms.dll</string>
    <string>System.Xml.dll</string>
    <string>System.Xml.Linq.dll</string>
    <string>Microsoft.CSharp.dll</string>
  </ReferenceAssemblies>
  <UsingText>using System;
using System.Collections.Generic;
using System.IO;
using System.Linq;
using System.Reflection;
using System.Runtime.InteropServices;
using System.Runtime.Remoting.Messaging;
using System.Runtime.Remoting.Proxies;
using System.Text;
using System.Windows.Forms;
using PEPlugin;
using PEPlugin.Pmx;
using PEPlugin.SDX;
using PEPlugin.Form;
using PEPlugin.View;</UsingText>
  <FullCodeText>public sealed class CSScriptClass : PEPluginClass
{
    private const string Title = "SCSP 模型一键处理 V2.0";
    private static bool running;

    public CSScriptClass()
    {
        m_option = new PEPluginOption(false, true, Title);
    }

    public override void Run(IPERunArgs args)
    {
        if (running) return;
        running = true;
        bool submitted = false;
        try
        {
            base.Run(args);
            IPEConnector editor = args.Host.Connector;
            IPXPmx input = editor.Pmx.GetCurrentState();
            string report;
            IPXPmx result = Process(input, args.Host.Builder, args.ModulePath, out report);
            editor.Pmx.Update(result);
            submitted = true;
            editor.Form.UpdateList(PEPlugin.Pmd.UpdateObject.All);
            editor.View.PMDView.UpdateModel();
            editor.View.PMDView.UpdateView();
            editor.View.TransformView.UpdateView();
            MessageBox.Show(report + "\n\n请在 PE 中另存为新的 PMX。", Title,
                MessageBoxButtons.OK, MessageBoxIcon.Information);
        }
        catch (Exception ex)
        {
            string context = submitted ? "模型已提交，刷新界面时出错。" : "处理未完成。";
            MessageBox.Show(context + "\n\n" + ex.Message, Title,
                MessageBoxButtons.OK, MessageBoxIcon.Warning);
        }
        finally
        {
            running = false;
        }
    }

    private static readonly string[] Sides = { "左", "右" };
    private static readonly string[] FootControls =
    {
        "左足ＩＫ", "左足ＩＫ親", "左つま先ＩＫ",
        "右足ＩＫ", "右足ＩＫ親", "右つま先ＩＫ"
    };

    internal static IPXPmx Process(IPXPmx model, IPEBuilder builder, string modulePath,
        out string report)
    {
        if (model == null || model.Bone.Count == 0 || model.Vertex.Count == 0)
            throw new InvalidOperationException("请先打开 MMD Tools 导出的 SCSP 人物 PMX。");

        CheckParents(model);
        StringBuilder summary = new StringBuilder();
        int initialBoneCount = model.Bone.Count;
        int renamed = Rename(model.Bone);
        Stage stage = new Stage(model, builder, modulePath);
        foreach (string name in new[] { "上半身", "下半身", "頭" })
            Need(model, name);
        foreach (string side in Sides)
            foreach (string name in new[] { "足", "ひざ", "足首", "つま先", "目", "肩", "腕", "ひじ", "手首" })
                Need(model, side + name);

        IPXBone center = Find(model, "センター");
        if (center == null)
        {
            center = MakeBone(builder.Pmx, "センター", "center", new V3(0f, 8f, 0f), null, true);
            model.Bone.Insert(0, center);
        }
        IPXBone groove = Find(model, "グルーブ");
        if (groove != null) groove.Name = "グルーブ";
        Need(model, "上半身").Parent = groove ?? center;
        Need(model, "下半身").Parent = groove ?? center;
        Register(builder.Pmx, Frame(model, builder.Pmx, "センター", "center"), center);
        if (Find(model, "全ての親") == null || groove == null)
            stage.RunSemi("第 5 步（总父级与 Groove）",
                "checkAllParent", "checkBox4", "checkAutoBoneList");
        model = stage.Model;
        IPXBone root = Need(model, "全ての親");
        center = Need(model, "センター");
        groove = Need(model, "グルーブ");
        root.Parent = null;
        center.Parent = root;
        groove.Parent = center;
        Need(model, "上半身").Parent = groove;
        Need(model, "下半身").Parent = groove;
        MoveTo(model.Bone, root, 0);
        MoveTo(model.Bone, center, 1);
        MoveTo(model.Bone, groove, 2);
        Register(builder.Pmx, Frame(model, builder.Pmx, "センター", "center"), groove);

        // The original plugins search the Japanese PMX name using exact spelling.
        foreach (string name in FootControls)
        {
            IPXBone existing = Find(model, name);
            if (existing != null) existing.Name = name.Replace("ＩＫ親", "IK親");
        }
        if (Sides.Any(s =&gt; Find(model, s + "足ＩＫ") == null || Find(model, s + "つま先ＩＫ") == null))
            stage.RunLeg();
        model = stage.Model;
        foreach (string side in Sides)
            CheckLeg(model, side, false);

        if (Sides.Any(s =&gt; new[] { "腕捩", "手捩", "足ＩＫ親", "肩P", "肩C" }.Any(n =&gt; Find(model, s + n) == null)))
            stage.RunSemi("第 7 步（扭转骨、足 IK 親和肩 P）",
                "checkBox1", "checkElbowPosOffset", "checkBox2", "checkBox7", "checkBox11", "checkAutoBoneList");
        model = stage.Model;

        int adjustedKnees = 0;
        IPXNode ik = Frame(model, builder.Pmx, "ＩＫ", "IK");
        foreach (string side in Sides)
        {
            foreach (string name in new[] { "腕捩", "手捩", "腕捩1", "腕捩2", "腕捩3", "手捩1", "手捩2", "手捩3", "肩P", "肩C" })
                Need(model, side + name);
            IPXBone shoulder = Need(model, side + "肩");
            IPXBone shoulderP = Need(model, side + "肩P");
            IPXBone shoulderC = Need(model, side + "肩C");
            if (!Same(shoulder.Parent, shoulderP) || !Same(shoulderC.Parent, shoulder)
                || !shoulderC.IsAppendRotation || !Same(shoulderC.AppendParent, shoulderP))
                throw new InvalidOperationException("第 7 步生成的肩 P/C 关系不完整：" + side);
            if (AdjustFootControls(model, side)) adjustedKnees++;
            CheckLeg(model, side, true);
        }
        foreach (string name in FootControls)
            Register(builder.Pmx, ik, Need(model, name));

        SetEyes(model, builder.Pmx);
        int missingMorphs = RegisterMorphs(model, builder.Pmx);
        CheckParents(model);
        foreach (IPXMaterial material in model.Material)
        {
            material.Diffuse = new V4(1f, 1f, 1f, material.Diffuse.W);
            material.Specular = new V3(0f, 0f, 0f);
        }

        summary.AppendLine("处理完成。");
        summary.AppendLine("改名 " + renamed + " 根，新增控制骨 " + (model.Bone.Count - initialBoneCount) + " 根。");
        summary.AppendLine("已检查左右足 IK 链和 6 个 IK 显示枠项目。");
        summary.AppendLine("已连接双目。表情 " + model.Morph.Count + " 个，补登记 " + missingMorphs + " 个。");
        summary.AppendLine("已处理 " + model.Material.Count + " 个材质的扩散色和反射色。");
        if (adjustedKnees &gt; 0) summary.AppendLine("已对 " + adjustedKnees + " 个近乎伸直的膝支点增加轻微前弯。");
        report = summary.ToString().TrimEnd();
        return model;
    }

    private static int Rename(IList&lt;IPXBone&gt; bones)
    {
        Dictionary&lt;string, string&gt; rules = new Dictionary&lt;string, string&gt;(StringComparer.OrdinalIgnoreCase);
        foreach (string line in Mapping.Split('\n'))
        {
            string[] pair = line.Trim().Split(',');
            if (pair.Length == 2 &amp;&amp; pair[1].Trim().Length &gt; 0)
                rules[pair[0].Trim()] = pair[1].Trim();
        }
        int count = 0;
        foreach (IPXBone bone in bones)
        {
            string name;
            if (!rules.TryGetValue(bone.Name ?? "", out name)) continue;
            if (bones.Any(b =&gt; !Same(b, bone) &amp;&amp; b.Name == name))
                throw new InvalidOperationException("骨骼改名发生冲突：" + bone.Name + " → " + name);
            if (String.IsNullOrWhiteSpace(bone.NameE)) bone.NameE = bone.Name;
            bone.Name = name;
            count++;
        }
        return count;
    }

    private static IPXBone MakeBone(IPXPmxBuilder builder, string name, string english,
        V3 position, IPXBone parent, bool movable)
    {
        IPXBone bone = builder.Bone();
        bone.Name = name;
        bone.NameE = english;
        bone.Position = position;
        bone.Parent = parent;
        bone.ToOffset = new V3(0f, 1f, 0f);
        bone.IsRotation = true;
        bone.IsTranslation = movable;
        bone.Visible = true;
        bone.Controllable = true;
        return bone;
    }

    private static IPXBone Find(IPXPmx model, string name)
    {
        string key = Key(name);
        IPXBone found = null;
        foreach (IPXBone bone in model.Bone)
        {
            if (!String.Equals(Key(bone.Name), key, StringComparison.OrdinalIgnoreCase)) continue;
            if (found != null) throw new InvalidOperationException("发现重复骨骼：" + name);
            found = bone;
        }
        return found;
    }

    private static string Key(string name)
    {
        string result = (name ?? "").Replace("ＩＫ", "IK");
        return result == "グループ" ? "グルーブ" : result;
    }

    private static IPXBone Need(IPXPmx model, string name)
    {
        IPXBone bone = Find(model, name);
        if (bone == null) throw new InvalidOperationException("缺少骨骼：" + name);
        return bone;
    }

    private static bool Same(object a, object b)
    {
        return Object.ReferenceEquals(a, b);
    }

    private static void MoveTo(IList&lt;IPXBone&gt; bones, IPXBone bone, int position)
    {
        int previous = bones.IndexOf(bone);
        if (previous == position) return;
        bones.RemoveAt(previous);
        bones.Insert(position, bone);
    }

    private static IPXNode Frame(IPXPmx model, IPXPmxBuilder builder, string name, string english)
    {
        IPXNode frame = model.Node.FirstOrDefault(n =&gt; Key(n.Name) == Key(name)
            || String.Equals(n.NameE, english, StringComparison.OrdinalIgnoreCase));
        if (frame != null) return frame;
        frame = builder.Node();
        frame.Name = name;
        frame.NameE = english;
        model.Node.Add(frame);
        return frame;
    }

    private static void Register(IPXPmxBuilder builder, IPXNode frame, IPXBone bone)
    {
        if (!frame.Items.Any(item =&gt; item.IsBone &amp;&amp; Same(item.BoneItem.Bone, bone)))
            frame.Items.Add(builder.BoneNodeItem(bone));
    }

    private static void CheckLeg(IPXPmx model, string side, bool checkParent)
    {
        IPXBone leg = Need(model, side + "足");
        IPXBone knee = Need(model, side + "ひざ");
        IPXBone ankle = Need(model, side + "足首");
        IPXBone toe = Need(model, side + "つま先");
        IPXBone footIk = Need(model, side + "足ＩＫ");
        IPXBone toeIk = Need(model, side + "つま先ＩＫ");
        if (!footIk.IsIK || footIk.IK == null || footIk.IK.Links.Count != 2
            || !Same(footIk.IK.Target, ankle) || !Same(footIk.IK.Links[0].Bone, knee)
            || !Same(footIk.IK.Links[1].Bone, leg)
            || !toeIk.IsIK || toeIk.IK == null || toeIk.IK.Links.Count != 1
            || !(Same(toeIk.IK.Target, toe) || (toeIk.IK.Target != null &amp;&amp; toeIk.IK.Target.Name == side + "足先EX"))
            || !Same(toeIk.IK.Links[0].Bone, ankle))
            throw new InvalidOperationException("第 6 步发现脚部 IK 链不完整：" + side);
        if (checkParent)
        {
            IPXBone parent = Need(model, side + "足ＩＫ親");
            if (!Same(parent.Parent, Need(model, "全ての親")) || !Same(footIk.Parent, parent) || !Same(toeIk.Parent, footIk))
                throw new InvalidOperationException("脚部 IK 父级有误：" + side);
        }
    }

    private static bool AdjustFootControls(IPXPmx model, string side)
    {
        IPXBone footIk = Need(model, side + "足ＩＫ");
        IPXBone toeIk = Need(model, side + "つま先ＩＫ");
        IPXBone parent = Need(model, side + "足ＩＫ親");
        parent.Name = side + "足ＩＫ親";
        parent.Parent = Need(model, "全ての親");
        footIk.Parent = parent;
        toeIk.Parent = footIk;
        IPXIKLink joint = footIk.IK.Links[0];
        if (!joint.IsLimit || Math.Abs(joint.High.X - Q.D2R(-0.5f)) &gt; 0.00001f
            || joint.High.Y != 0f || joint.High.Z != 0f)
            return false;

        // The bundled leg plugin excludes 0 degrees. Permit the rest pose and give
        // nearly collinear SCSP knees a small forward bias for the bend direction.
        joint.High = new V3(0f, 0f, 0f);
        V3 hip = Need(model, side + "足").Position;
        IPXBone knee = joint.Bone;
        V3 pivot = knee.Position;
        V3 ankle = footIk.IK.Target.Position;
        float height = hip.Y - ankle.Y;
        if (height &lt; 0.001f || pivot.Y &gt;= hip.Y || pivot.Y &lt;= ankle.Y) return false;
        float fraction = (hip.Y - pivot.Y) / height;
        float straightZ = hip.Z + fraction * (ankle.Z - hip.Z);
        float bias = 0.02f * (hip.Y - pivot.Y);
        float forwardZ = straightZ - bias;
        if (pivot.Z &lt;= forwardZ || pivot.Z &gt; straightZ + bias) return false;
        knee.Position = new V3(pivot.X, pivot.Y, forwardZ);
        return true;
    }

    private static void SetEyes(IPXPmx model, IPXPmxBuilder builder)
    {
        IPXBone head = Need(model, "頭");
        IPXBone left = Need(model, "左目");
        IPXBone right = Need(model, "右目");
        IPXBone both = Find(model, "両目");
        if (both == null)
        {
            both = MakeBone(builder, "両目", "eyes", new V3(0f, 18f, -0.095f), head, false);
            model.Bone.Insert(Math.Min(model.Bone.IndexOf(left), model.Bone.IndexOf(right)), both);
        }
        both.Parent = head;
        both.IsRotation = true;
        both.IsTranslation = false;
        both.IsIK = false;
        both.Visible = true;
        both.Controllable = true;
        both.Level = head.Level;
        int firstEye = Math.Min(model.Bone.IndexOf(left), model.Bone.IndexOf(right));
        if (model.Bone.IndexOf(both) &gt; firstEye) MoveTo(model.Bone, both, firstEye);
        foreach (IPXBone eye in new[] { left, right })
        {
            eye.Parent = head;
            eye.IsRotation = true;
            eye.IsTranslation = false;
            // PPT's “旋转 +” is the append checkbox, not the basic rotation flag.
            eye.IsAppendLocal = false;
            eye.IsAppendRotation = true;
            eye.IsAppendTranslation = false;
            eye.AppendParent = both;
            eye.AppendRatio = 1f;
            eye.Level = Math.Max(1, both.Level + 1);
        }
        Register(builder, Frame(model, builder, "目", "Eyes"), both);
    }

    private static int RegisterMorphs(IPXPmx model, IPXPmxBuilder builder)
    {
        int count = 0;
        HashSet&lt;IPXMorph&gt; registered = new HashSet&lt;IPXMorph&gt;();
        foreach (IPXNode frame in model.Node.Concat(new[] { model.RootNode, model.ExpressionNode }))
            foreach (IPXNodeItem item in frame.Items)
                if (item.IsMorph &amp;&amp; item.MorphItem.Morph != null) registered.Add(item.MorphItem.Morph);
        foreach (IPXMorph morph in model.Morph)
        {
            if (morph.Panel == 0 || !registered.Add(morph)) continue;
            model.ExpressionNode.Items.Add(builder.MorphNodeItem(morph));
            count++;
        }
        return count;
    }

    private static void CheckParents(IPXPmx model)
    {
        HashSet&lt;IPXBone&gt; bones = new HashSet&lt;IPXBone&gt;(model.Bone);
        foreach (IPXBone bone in model.Bone)
        {
            HashSet&lt;IPXBone&gt; visited = new HashSet&lt;IPXBone&gt;();
            for (IPXBone current = bone; current != null; current = current.Parent)
                if (!bones.Contains(current) || !visited.Add(current))
                    throw new InvalidOperationException("骨骼父级存在断链或循环：" + bone.Name);
        }
    }

    // Both originals read a model and submit it through the PE connector. Give
    // them the working copy so PE receives only a validated final result.
    private sealed class Stage
    {
        internal IPXPmx Model { get; private set; }
        private readonly IPERunArgs args;
        private bool receivedUpdate;

        internal Stage(IPXPmx model, IPEBuilder builder, string modulePath)
        {
            Model = model;
            IPXPmxConnector pmx = Port&lt;IPXPmxConnector&gt;((name, values) =&gt;
            {
                switch (name)
                {
                    case "GetCurrentState": return Model;
                    case "Update":
                        Model = (IPXPmx)values[0];
                        receivedUpdate = true;
                        return null;
                    default: throw new NotSupportedException(name);
                }
            });
            IPEFormConnector form = Port&lt;IPEFormConnector&gt;((name, values) =&gt; null);
            IPEPMDViewConnector pmd = Port&lt;IPEPMDViewConnector&gt;((name, values) =&gt; null);
            IPETransformViewConnector transform = Port&lt;IPETransformViewConnector&gt;((name, values) =&gt; null);
            IPEViewConnector view = Port&lt;IPEViewConnector&gt;((name, values) =&gt;
                name == "get_PMDView" ? (object)pmd : transform);
            IPESystemConnector system = Port&lt;IPESystemConnector&gt;((name, values) =&gt; Path.GetTempPath());
            IPEConnector connector = Port&lt;IPEConnector&gt;((name, values) =&gt;
            {
                switch (name)
                {
                    case "get_Pmx": return pmx;
                    case "get_Form": return form;
                    case "get_View": return view;
                    case "get_System": return system;
                    default: throw new NotSupportedException(name);
                }
            });
            IPEPluginHost host = Port&lt;IPEPluginHost&gt;((name, values) =&gt;
            {
                switch (name)
                {
                    case "get_Builder": return builder;
                    case "get_Connector": return connector;
                    default: throw new NotSupportedException(name);
                }
            });
            args = Port&lt;IPERunArgs&gt;((name, values) =&gt;
            {
                switch (name)
                {
                    case "get_Host": return host;
                    case "get_IsBootup": return false;
                    case "get_ModulePath": return modulePath;
                    default: throw new NotSupportedException(name);
                }
            });
        }

        private static readonly Lazy&lt;Assembly&gt; SemiAssembly =
            new Lazy&lt;Assembly&gt;(() =&gt; Assembly.Load(Convert.FromBase64String(SemiDll)));
        private static readonly Lazy&lt;Assembly&gt; LegAssembly =
            new Lazy&lt;Assembly&gt;(() =&gt; Assembly.Load(Convert.FromBase64String(LegDll)));

        internal void RunSemi(string step, params string[] options)
        {
            RunOriginal(SemiAssembly.Value, "SemiStandardBonesPMX.SemiStandardBonesPMX", step, options);
        }

        internal void RunLeg()
        {
            RunOriginal(LegAssembly.Value, "PECSScriptPlugin.CSScriptClass", "第 6 步（腿与脚尖 IK）", null);
        }

        private void RunOriginal(Assembly assembly, string typeName, string step, string[] options)
        {
            receivedUpdate = false;
            IPEPlugin plugin = (IPEPlugin)Activator.CreateInstance(assembly.GetType(typeName, true), true);
            Exception dialogError = null;
            bool confirmed = false;
            bool acknowledged = false;
            HashSet&lt;Form&gt; existingForms = new HashSet&lt;Form&gt;(Application.OpenForms.Cast&lt;Form&gt;());
            using (System.Windows.Forms.Timer timer = new System.Windows.Forms.Timer())
            {
                timer.Interval = 40;
                timer.Tick += (sender, eventArgs) =&gt;
                {
                    if (options != null &amp;&amp; !confirmed &amp;&amp; dialogError == null)
                    {
                        Form form = Application.OpenForms.Cast&lt;Form&gt;().FirstOrDefault(f =&gt;
                            f.GetType().Assembly == assembly &amp;&amp; f.GetType().FullName == "SemiStandardBonesPMX.Form1"
                            &amp;&amp; f.Modal &amp;&amp; f.Visible &amp;&amp; !existingForms.Contains(f));
                        if (form != null)
                        {
                            try
                            {
                                SetOptions(form, options);
                                confirmed = true;
                                form.DialogResult = DialogResult.OK;
                            }
                            catch (Exception ex)
                            {
                                dialogError = ex;
                                form.DialogResult = DialogResult.Cancel;
                            }
                        }
                    }
                    if (options == null &amp;&amp; !confirmed)
                        confirmed = AnswerDialog("Confirm", 6, "This will create 2 leg IK bones");
                    if (confirmed &amp;&amp; !acknowledged)
                    {
                        if (options == null)
                            acknowledged = AnswerDialog("Result", 1, "Done!");
                        else
                            acknowledged = AnswerDialog(plugin.Name, 1, "以下骨骼追加完毕了。")
                                || AnswerDialog(plugin.Name, 1, "没有能追加的骨骼。");
                    }
                };
                try
                {
                    timer.Start();
                    plugin.Run(args);
                }
                catch (Exception ex)
                {
                    throw new InvalidOperationException(step + "失败：" + ex.Message, ex);
                }
                finally
                {
                    timer.Stop();
                    plugin.Dispose();
                }
            }
            if (dialogError != null) throw new InvalidOperationException(step + "无法设置插件选项：" + dialogError.Message);
            if (!confirmed) throw new InvalidOperationException(step + "没有确认插件选项。");
            if (!receivedUpdate) throw new InvalidOperationException(step + "没有生成结果。");
        }

        private static void SetOptions(Form form, string[] options)
        {
            CheckBox[] checkBoxes = form.Controls.OfType&lt;CheckBox&gt;().ToArray();
            if (options.Any(name =&gt; !checkBoxes.Any(box =&gt; box.Name == name)))
                throw new InvalidOperationException("原插件选项与预期不一致。");
            foreach (CheckBox box in checkBoxes) box.Checked = false;
            foreach (string name in options) checkBoxes.Single(box =&gt; box.Name == name).Checked = true;
            if (checkBoxes.Any(box =&gt; box.Checked != options.Contains(box.Name)))
                throw new InvalidOperationException("复选框状态与 PPT 不一致。");
        }
    }

    private static T Port&lt;T&gt;(Func&lt;string, object[], object&gt; invoke) where T : class
    {
        return (T)new ConnectorPort(typeof(T), invoke).GetTransparentProxy();
    }

    private sealed class ConnectorPort : RealProxy
    {
        private readonly Func&lt;string, object[], object&gt; dispatch;

        internal ConnectorPort(Type type, Func&lt;string, object[], object&gt; dispatch)
            : base(type)
        {
            this.dispatch = dispatch;
        }

        public override IMessage Invoke(IMessage message)
        {
            IMethodCallMessage call = (IMethodCallMessage)message;
            try
            {
                object response = dispatch(call.MethodName, call.Args);
                return new ReturnMessage(response, null, 0, call.LogicalCallContext, call);
            }
            catch (Exception ex)
            {
                return new ReturnMessage(ex, call);
            }
        }
    }

    // The original plugins have standard Win32 confirmation/result dialogs.
    // Address only dialogs created by the current PE UI thread.
    private static bool AnswerDialog(string caption, int button, string bodyPrefix)
    {
        bool answered = false;
        EnumThreadWindows(GetCurrentThreadId(), (window, state) =&gt;
        {
            StringBuilder windowClass = new StringBuilder(32);
            GetClassName(window, windowClass, windowClass.Capacity);
            if (windowClass.ToString() != "#32770" || WindowText(window) != caption) return true;
            IntPtr control = GetDlgItem(window, button);
            if (control == IntPtr.Zero &amp;&amp; button == 1) control = GetDlgItem(window, 2);
            if (control == IntPtr.Zero) return true;
            if (bodyPrefix.Length &gt; 0)
            {
                bool matched = false;
                EnumChildWindows(window, (child, unused) =&gt;
                {
                    matched = WindowText(child).StartsWith(bodyPrefix, StringComparison.Ordinal);
                    return !matched;
                }, IntPtr.Zero);
                if (!matched) return true;
            }
            answered = PostMessage(control, 0x00F5, IntPtr.Zero, IntPtr.Zero);
            return !answered;
        }, IntPtr.Zero);
        return answered;
    }

    private static string WindowText(IntPtr window)
    {
        StringBuilder text = new StringBuilder(512);
        GetWindowText(window, text, text.Capacity);
        return text.ToString();
    }

    private delegate bool EnumerateWindow(IntPtr window, IntPtr state);

    [DllImport("kernel32.dll")]
    private static extern uint GetCurrentThreadId();
    [DllImport("user32.dll")]
    private static extern bool EnumThreadWindows(uint thread, EnumerateWindow callback, IntPtr state);
    [DllImport("user32.dll")]
    private static extern bool EnumChildWindows(IntPtr window, EnumerateWindow callback, IntPtr state);
    [DllImport("user32.dll", CharSet = CharSet.Unicode)]
    private static extern int GetClassName(IntPtr window, StringBuilder text, int max);
    [DllImport("user32.dll", CharSet = CharSet.Unicode)]
    private static extern int GetWindowText(IntPtr window, StringBuilder text, int max);
    [DllImport("user32.dll")]
    private static extern IntPtr GetDlgItem(IntPtr window, int id);
    [DllImport("user32.dll")]
    private static extern bool PostMessage(IntPtr window, uint message, IntPtr wParam, IntPtr lParam);

